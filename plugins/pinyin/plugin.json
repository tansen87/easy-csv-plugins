{
  "name": "pinyin",
  "title": "pinyin",
  "description": "Convert Chinese characters in a column to pinyin",
  "homepage": "https://github.com/tansen87/easy-csv/tree/main/plugins/pinyin-cli",
  "license": "MIT",
  "required": false,
  "version": "0.1.0",
  "versionArgs": ["--version"],
  "assets": {
    "windows-x86_64": {
      "file": "pinyin.exe",
      "upstream": {
        "kind": "cargo",
        "repo": "tansen87/easy-csv",
        "path": "plugins/pinyin-cli",
        "target": "x86_64-pc-windows-msvc"
      }
    },
    "macos-aarch64": {
      "file": "pinyin",
      "upstream": {
        "kind": "cargo",
        "repo": "tansen87/easy-csv",
        "path": "plugins/pinyin-cli",
        "target": "aarch64-apple-darwin"
      }
    },
    "macos-x86_64": {
      "file": "pinyin",
      "upstream": {
        "kind": "cargo",
        "repo": "tansen87/easy-csv",
        "path": "plugins/pinyin-cli",
        "target": "x86_64-apple-darwin"
      }
    },
    "linux-x86_64-gnu": {
      "file": "pinyin",
      "upstream": {
        "kind": "cargo",
        "repo": "tansen87/easy-csv",
        "path": "plugins/pinyin-cli",
        "target": "x86_64-unknown-linux-gnu"
      }
    },
    "linux-aarch64-gnu": {
      "file": "pinyin",
      "upstream": {
        "kind": "cargo",
        "repo": "tansen87/easy-csv",
        "path": "plugins/pinyin-cli",
        "target": "aarch64-unknown-linux-gnu"
      }
    }
  }
}
